# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/app_2026

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# Mail (SMTP) - for email verification and password reset
# Gmail: use SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password for SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Your App Name
APP_BASE_URL=http://localhost:3000

# CORS - comma-separated origins for frontend (required for cookie-based auth)
CORS_ORIGIN=http://localhost:4200

