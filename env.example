# ============================================
# Server Configuration
# ============================================
# Port number for the server to listen on
PORT=3000

# Environment mode: development, production, or test
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Example: mongodb://localhost:27017/app_2026
# Example with auth: mongodb://user:pass@localhost:27017/app_2026?authSource=admin
MONGODB_URI=mongodb://localhost:27017/app_2026

# ============================================
# JWT Configuration
# ============================================
# Secret key for signing JWT access tokens
# IMPORTANT: Change this to a strong random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# Access token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 15m, 1h, 7d
JWT_EXPIRES_IN=15m

# Secret key for signing JWT refresh tokens
# IMPORTANT: Change this to a different strong random string in production!
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Refresh token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 7d, 30d, 90d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Email Configuration (SMTP)
# ============================================
# SMTP server hostname
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# Yahoo: smtp.mail.yahoo.com
# Custom: smtp.yourdomain.com
SMTP_HOST=smtp.gmail.com

# SMTP server port
# 587 for TLS (recommended)
# 465 for SSL
# 25 for unencrypted (not recommended)
SMTP_PORT=587

# Use secure connection (SSL/TLS)
# true for port 465 (SSL)
# false for port 587 (TLS)
SMTP_SECURE=false

# SMTP username (usually your email address)
# For Gmail: your-email@gmail.com
# REQUIRED: Must be set in .env file (no default value)
SMTP_USER=your-email@gmail.com

# SMTP password
# For Gmail: Use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# For other providers: Use your email password or app-specific password
# REQUIRED: Must be set in .env file (no default value)
SMTP_PASS=your-app-password

# Email address to send from
# Usually same as SMTP_USER, but can be different if your SMTP server allows it
# Default: Same as SMTP_USER or noreply@example.com (if not set)
EMAIL_FROM=your-email@gmail.com

# Display name for the sender
# Default: App 2026 (if not set)
EMAIL_FROM_NAME=App 2026

# ============================================
# Application Configuration
# ============================================
# Base URL of your application (used in email links)
# Development: http://localhost:3000/api
# Production: https://yourdomain.com/api
APP_URL=http://localhost:3000/api

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated for multiple origins)
# Development: http://localhost:3000, http://localhost:5173, http://localhost:3001
# Production: https://yourdomain.com, https://www.yourdomain.com
# For all origins (not recommended for production): *
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001
